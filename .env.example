# coding-agent environment variables
# Copy this file to .env and edit for your setup.
#
# config.json holds the main configuration (see config.example.json).
# The variables below are optional and used for debug-adapter paths and
# diagnostics tracing.

# --- Debug adapter paths (optional) ---
# PHP debugging via Xdebug: path to the built vscode-php-debug adapter
#   git clone https://github.com/xdebug/vscode-php-debug && npm install && npm run build
CODING_AGENT_PHP_ADAPTER=

# JavaScript debugging via Microsoft js-debug: path to dapDebugServer.js
#   Download js-debug-dap from https://github.com/microsoft/vscode-js-debug/releases
CODING_AGENT_JS_ADAPTER=

# --- Custom embedding model (optional) ---
# Override the default local gte-modernbert-base ONNX model path
# CODING_AGENT_EMBED_MODEL=/path/to/model.onnx

# --- Diagnostics tracing (optional, for development) ---
# Enable LSP protocol message tracing to stderr
# CODING_AGENT_LSP_TRACE=1
# Enable DAP protocol message tracing to stderr
# CODING_AGENT_DAP_TRACE=1
