{
  "llm": {
    "base_url": "https://api.provider.com/v1",
    "api_key": "YOUR_API_KEY",
    "model": "provider-model-name",
    "temperature": 0.2,
    "max_tokens": 4096,
    "context_limit": 128000
  },
  "git": {
    "allow_destructive": false
  },
  "test_runners": {},
  "language_servers": {
    "python":     {"command": ["pyright-langserver", "--stdio"]},
    "javascript": {"command": ["typescript-language-server", "--stdio"]},
    "typescript": {"command": ["typescript-language-server", "--stdio"]},
    "php":        {"command": ["intelephense", "--stdio"]},
    "html":       {"command": ["vscode-html-language-server", "--stdio"]},
    "css":        {"command": ["vscode-css-language-server", "--stdio"]},
    "scss":       {"command": ["vscode-css-language-server", "--stdio"]}
  },
  "debug_adapters": {
    "python": {"command": ["python3", "-m", "debugpy.adapter"]}
  }
}
