{
  "llm": {
    "base_url": "http://localhost:8080/v1",
    "api_key": "your-api-key-here",
    "model": "your-model-name",
    "context_limit": 128000
  },
  "_vision": {
    "_comment": "Optional second provider, disabled while this key is named '_vision' — rename it to 'vision' to enable. With it, a screenshot taken in verify mode is sent to THIS endpoint alone and only its text description reaches the main model, so a text-only main model can still verify a page. Same keys as 'llm'.",
    "base_url": "http://vision-host:8000/v1",
    "api_key": "your-api-key-here",
    "model": "your-vision-model-name",
    "context_limit": 16000
  },
  "git": {
    "allow_destructive": false
  },
  "test_runners": {},
  "compaction": {"reserve_ratio": 0.10, "reserve_min_tokens": 8000, "keep_recent_messages": 8},
  "subagents": {"max_concurrent": 4, "timeout_s": 3600},
  "linters": {
    "python":     {"command": ["ruff", "check", "--output-format", "json"]},
    "javascript": {"command": ["eslint", "--format", "json"]},
    "typescript": {"command": ["eslint", "--format", "json"]},
    "php":        {"command": ["phpstan", "analyse", "--error-format", "json", "--no-progress", "--level", "0"]}
  },
  "language_servers": {
    "python":     {"command": ["pyright-langserver", "--stdio"]},
    "javascript": {"command": ["typescript-language-server", "--stdio"]},
    "typescript": {"command": ["typescript-language-server", "--stdio"]},
    "php":        {"command": ["intelephense", "--stdio"]},
    "html":       {"command": ["vscode-html-language-server", "--stdio"]},
    "css":        {"command": ["vscode-css-language-server", "--stdio"]},
    "scss":       {"command": ["vscode-css-language-server", "--stdio"]}
  },
  "debug_adapters": {
    "python":     {"command": ["python3", "-m", "debugpy.adapter"]},
    "php":        {"command": ["node", "${CODING_AGENT_PHP_ADAPTER}"]},
    "javascript": {"command": ["node", "${CODING_AGENT_JS_ADAPTER}"], "transport": "tcp"}
  }
}
